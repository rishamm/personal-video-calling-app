# This is the generated .gitignore for Node projects.
# It includes common patterns for local development, dependency folders, and build outputs.

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Dependency directories
node_modules/
client/node_modules/

# Build output
client/dist/
dist/

# Local env files
a.env
.env
.env.*

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/

# Vite cache
.vite/

# Coverage
test-output/
coverage/
